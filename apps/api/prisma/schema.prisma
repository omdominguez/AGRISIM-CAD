// ============================================================================
// CAD Agrícola — Schema de base de datos (PostgreSQL / Supabase)
// ERP de financiamiento a campo — Comercializadora Agrícola Domínguez
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// AUTENTICACIÓN Y ROLES
// ----------------------------------------------------------------------------

enum RolUsuario {
  MASTER_ADMIN    // Control total: usuarios, roles, configuración
  GERENTE         // Aprueba financiamientos, contrata, liquida
  TECNICO_CAMPO   // Carga ciclos, lotes, inspecciones, despachos
  JUNTA_DIRECTIVA // Solo lectura: dashboards y reportes
}

model Usuario {
  id           String     @id @default(uuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  telefono     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ultimoLogin  DateTime?

  parcelasCargadas         Parcela[]                 @relation("CargadaPor")
  ciclosCreados            Ciclo[]                   @relation("CicloCreadoPor")
  participacionesAsignadas CicloProductor[]          @relation("TecnicoResponsable")
  solicitudesEvaluadas     SolicitudFinanciamiento[] @relation("EvaluadoPor")
  solicitudesAprobadas     SolicitudFinanciamiento[] @relation("AprobadoPor")
  despachosRealizados      Despacho[]                @relation("DespachoResponsable")
  inspeccionesRealizadas   InspeccionCampo[]         @relation("InspeccionTecnico")
  registrosLluvia          RegistroLluvia[]          @relation("RegistroLluviaPor")
  comprasRegistradas       CompraInsumo[]            @relation("CompraRegistradaPor")
  retirosRegistrados       RetiroInsumo[]            @relation("RetiroRegistradoPor")
  ventasRegistradas        Venta[]                   @relation("VentaRegistradaPor")
  movimientosRegistrados   MovimientoCuenta[]        @relation("MovimientoRegistradoPor")
  logsAuditoria            LogAuditoria[]

  @@map("usuarios")
}

model LogAuditoria {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  accion    String
  entidad   String
  entidadId String?
  detalle   Json?
  createdAt DateTime @default(now())

  @@map("logs_auditoria")
}

// ----------------------------------------------------------------------------
// PRODUCTORES, FINCAS Y PARCELAS (GIS)
// El técnico crea el productor una sola vez; después solo lo selecciona.
// ----------------------------------------------------------------------------

model Productor {
  id            String  @id @default(uuid())
  codigoSima    String? @unique // código del productor en SIMA
  nombre        String
  cedulaRif     String? @unique
  telefono      String?
  email         String?
  estado    String? // estado de Venezuela (lista cerrada)
  municipio String? // municipio dentro del estado (lista cerrada)
  activo        Boolean @default(true)

  // Scoring interno de riesgo (IDP), alimentado por el histórico de cumplimiento.
  indiceDesempeno Decimal? @db.Decimal(5, 2) // 0-100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fincas          Finca[]
  participaciones CicloProductor[]
  movimientos     MovimientoCuenta[]

  @@map("productores")
}

model Finca {
  id            String    @id @default(uuid())
  productorId   String
  productor     Productor @relation(fields: [productorId], references: [id])
  nombre        String
  codigoSima    String?   @unique
  municipio     String?
  estado        String?
  areaHectareas Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())

  lotes Parcela[]

  @@map("fincas")
}

// Parcela = geometría del lote importada desde SIMA (KML/KMZ).
// El área se CALCULA de la geometría, no se digita — así el sistema
// toma las hectáreas exactas del lote tal como fue mapeado.
model Parcela {
  id         String  @id @default(uuid())
  fincaId    String
  finca      Finca   @relation(fields: [fincaId], references: [id])
  nombreLote String
  codigoSima String? @unique

  geoJson            Json     // Polygon/MultiPolygon listo para Leaflet
  areaCalculadaHa    Decimal  @db.Decimal(10, 4) // geodésica, desde el polígono
  areaDeclaradaHa    Decimal? @db.Decimal(10, 2) // opcional: lo que declara el productor
  archivoOriginalUrl String?  // .kml/.kmz original en Supabase Storage
  centroideLat       Decimal? @db.Decimal(10, 6)
  centroideLng       Decimal? @db.Decimal(10, 6)

  cargadaPorId String?
  cargadaPor   Usuario? @relation("CargadaPor", fields: [cargadaPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotesSiembra LoteSiembra[]
  registrosLluvia RegistroLluvia[]

  @@map("parcelas")
}

// Histórico de lluvia por parcela — un registro por día. `mmEstimado` viene
// automático de Open-Meteo (corre solo, ver news-feed-style cron en el
// servicio); `mmMedido` es lo que el técnico digita si tiene pluviómetro
// real en el lote — cuando existe, es la cifra que manda para análisis.
model RegistroLluvia {
  id          String   @id @default(uuid())
  parcelaId   String
  parcela     Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  fecha       DateTime // día calendario del registro (medianoche UTC de ese día)
  mmEstimado  Decimal? @db.Decimal(6, 2) // automático, vía Open-Meteo
  mmMedido    Decimal? @db.Decimal(6, 2) // digitado por el técnico, si tiene pluviómetro

  registradoPorId String?
  registradoPor   Usuario? @relation("RegistroLluviaPor", fields: [registradoPorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([parcelaId, fecha]) // un solo registro por parcela por día — se actualiza, no se duplica
  @@map("registros_lluvia")
}

// ============================================================================
// CICLO-CAMPAÑA
// Un ciclo agrupa MUCHOS productores. Cada productor participa con
// uno o varios lotes de siembra.
// ============================================================================

enum TipoCiclo {
  NORTE_VERANO
  INVIERNO
}

enum EstadoCiclo {
  PLANIFICACION // se está armando: sumando productores y lotes
  EN_CURSO      // ya hay siembra en campo
  COSECHA       // en proceso de cosecha/recepción
  CERRADO
}

model Ciclo {
  id      String      @id @default(uuid())
  nombre  String      @unique // "Norte Verano 2026-2027"
  tipo    TipoCiclo
  estado  EstadoCiclo @default(PLANIFICACION)
  cultivo String      // Frijol Pico Negro / Frijol Mung / Maíz

  fechaInicio    DateTime
  fechaCierreEst DateTime?

  // Metas declaradas al abrir el ciclo. El sistema las compara contra
  // lo realmente inscrito (participaciones) y lo realmente sembrado (lotes).
  metaProductores Int
  metaHectareas   Decimal @db.Decimal(10, 2)

  // Precio de referencia para proyectar liquidación y efectivo necesario.
  precioReferenciaQq Decimal? @db.Decimal(12, 2)

  creadoPorId String?
  creadoPor   Usuario? @relation("CicloCreadoPor", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participaciones CicloProductor[]

  @@map("ciclos")
}

// Participación de UN productor en UN ciclo.
// Es la unidad sobre la que corre el financiamiento y el estado de cuenta.
model CicloProductor {
  id          String    @id @default(uuid())
  cicloId     String
  ciclo       Ciclo     @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  productorId String
  productor   Productor @relation(fields: [productorId], references: [id])

  hectareasComprometidas Decimal @db.Decimal(10, 2)

  tecnicoResponsableId String?
  tecnicoResponsable   Usuario? @relation("TecnicoResponsable", fields: [tecnicoResponsableId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotes        LoteSiembra[]
  solicitud    SolicitudFinanciamiento?
  inspecciones InspeccionCampo[]
  movimientos  MovimientoCuenta[]

  @@unique([cicloId, productorId]) // no se inscribe dos veces en el mismo ciclo
  @@map("ciclo_productores")
}

// Lote efectivamente sembrado. El área viene del KML (Parcela.areaCalculadaHa),
// no se digita a mano.
model LoteSiembra {
  id               String         @id @default(uuid())
  cicloProductorId String
  cicloProductor   CicloProductor @relation(fields: [cicloProductorId], references: [id], onDelete: Cascade)
  parcelaId        String
  parcela          Parcela        @relation(fields: [parcelaId], references: [id])

  areaSembradaHa Decimal   @db.Decimal(10, 4) // copiada de parcela.areaCalculadaHa
  fechaSiembra   DateTime?

  // Parámetros de siembra — base del cálculo de población de plantas.
  distanciaSurcosM            Decimal? @db.Decimal(5, 3) // ej. 0.45 m entre surcos
  densidadObjetivoPlantasPorM Decimal? @db.Decimal(6, 2) // plantas objetivo por metro lineal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspecciones InspeccionCampo[]

  @@unique([cicloProductorId, parcelaId])
  @@map("lotes_siembra")
}

// ============================================================================
// SEGUIMIENTO TÉCNICO EN CAMPO
// Lo que el técnico carga en cada visita. Alimenta el dashboard con data real.
// ============================================================================

// Estado del cultivo a lo largo de todo el ciclo — desde antes de sembrar
// hasta la cosecha. V1/V2/V3... son las etapas vegetativas por número de
// hojas, la forma estándar en que un técnico agrónomo describe el avance.
enum EstadoFenologico {
  PREPARACION_TIERRA
  SIEMBRA
  EMERGENCIA
  V1
  V2
  V3
  V4
  V5
  V6_O_MAS
  FLORACION
  LLENADO_GRANO
  MADURACION
  COSECHA
}

// El tipo de visita determina qué datos tiene sentido pedirle al técnico —
// una visita de preparación de tierra no necesita conteo de plantas, y una
// de seguimiento vegetativo no necesita checklist de arado.
enum TipoVisita {
  PREPARACION_TIERRA
  SIEMBRA
  SEGUIMIENTO
  COSECHA
}

enum TipoIncidencia {
  PLAGA
  ENFERMEDAD
  MALEZA
  DEFICIENCIA_NUTRICIONAL
  DANO_CLIMATICO
}

model InspeccionCampo {
  id               String         @id @default(uuid())
  cicloProductorId String
  cicloProductor   CicloProductor @relation(fields: [cicloProductorId], references: [id], onDelete: Cascade)
  loteId           String?
  lote             LoteSiembra?   @relation(fields: [loteId], references: [id])

  fecha     DateTime
  tecnicoId String
  tecnico   Usuario  @relation("InspeccionTecnico", fields: [tecnicoId], references: [id])

  // El tipo de visita decide qué campos de abajo aplican — el formulario
  // en pantalla solo muestra los relevantes para cada tipo.
  tipoVisita TipoVisita @default(SEGUIMIENTO)

  // --- Solo aplica si tipoVisita = PREPARACION_TIERRA ---
  prepArado             Boolean?
  prepRastra            Boolean?
  prepNivelacion        Boolean?
  prepHumedadAdecuada   Boolean?

  // --- Solo aplica si tipoVisita = SIEMBRA ---
  metodoSiembra        String?  // ej. "Mecanizada", "Manual"
  profundidadSiembraCm Decimal? @db.Decimal(5, 2)

  // --- Área real en pie (SEGUIMIENTO / COSECHA) ---
  areaEfectivaHa Decimal? @db.Decimal(10, 4)

  // --- Población de plantas (SEGUIMIENTO) ---
  // El técnico cuenta plantas en un metro lineal; el sistema extrapola.
  plantasPorMetroLineal    Decimal? @db.Decimal(6, 2)
  plantasEstimadasTotal    Decimal? @db.Decimal(14, 0)
  plantasObjetivoTotal     Decimal? @db.Decimal(14, 0)
  porcentajeLogroPoblacion Decimal? @db.Decimal(6, 4)

  estadoFenologico   EstadoFenologico?
  usoAdecuadoInsumos Boolean?

  // --- Proyección de cosecha actualizada en esta visita (SEGUIMIENTO / COSECHA) ---
  rendimientoProyectadoQqHa Decimal? @db.Decimal(10, 2)

  observaciones String?

  createdAt DateTime @default(now())

  incidencias Incidencia[]

  @@map("inspecciones_campo")
}

// Plagas, enfermedades y demás hallazgos de una inspección.
model Incidencia {
  id           String          @id @default(uuid())
  inspeccionId String
  inspeccion   InspeccionCampo @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  tipo                TipoIncidencia
  nombreComun         String  // ej. "Mosca blanca", "Mustia hilachosa"
  severidad           Int     // escala 1 (leve) a 5 (crítica)
  porcentajeAfectado  Decimal? @db.Decimal(5, 2)
  accionRecomendada   String?
  aplicacionRealizada String?

  createdAt DateTime @default(now())

  @@map("incidencias")
}

// ============================================================================
// EXPEDIENTE DE FINANCIAMIENTO (flujo de 6 pasos de CAD)
//   1. Evaluación → 2. Paquete + anticipo → 3. Aprobación y contrato
//   4. Despacho → 5. Seguimiento → 6. Liquidación
// Cobro = (Insumos × (1 + margen 30%)) + (Anticipo × (1 + recargo 5%))
// ============================================================================

enum EstadoSolicitud {
  SOLICITUD_RECIBIDA
  PAQUETE_DEFINIDO
  APROBADA
  CONTRATO_FIRMADO
  DESPACHADA
  EN_SEGUIMIENTO
  COSECHADA
  LIQUIDADA
  RECHAZADA
  CANCELADA
}

enum CategoriaInsumo {
  SEMILLA
  FERTILIZANTE
  AGROQUIMICO
  MECANIZACION
  OTRO
}

enum TipoContrato {
  FINANCIAMIENTO_INSUMOS
  COMPRA_VENTA
  MIXTO
}

enum TipoDespacho {
  INSUMOS
  ANTICIPO_EFECTIVO
}

model SolicitudFinanciamiento {
  id               String          @id @default(uuid())
  cicloProductorId String          @unique
  cicloProductor   CicloProductor  @relation(fields: [cicloProductorId], references: [id], onDelete: Cascade)
  estado           EstadoSolicitud @default(SOLICITUD_RECIBIDA)

  // Paso 1 — Evaluación y caracterización
  areaVerificadaHa  Decimal?  @db.Decimal(10, 2)
  evaluacionTecnica String?
  evaluadoPorId     String?
  evaluadoPor       Usuario?  @relation("EvaluadoPor", fields: [evaluadoPorId], references: [id])
  fechaEvaluacion   DateTime?

  // Paso 2 — Paquete tecnológico y anticipo
  margenInsumosPct        Decimal  @default(0.30) @db.Decimal(5, 4)
  solicitaAnticipo        Boolean  @default(false)
  montoAnticipoSolicitado Decimal? @db.Decimal(14, 2)
  recargoAnticipoPct      Decimal  @default(0.05) @db.Decimal(5, 4)

  // Paso 3 — Aprobación
  montoAnticipoAprobado Decimal?  @db.Decimal(14, 2)
  aprobadoPorId         String?
  aprobadoPor           Usuario?  @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion       DateTime?
  motivoRechazo         String?

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemsPaquete PaqueteItem[]
  retiros      RetiroInsumo[]
  ventas       Venta[]
  contrato     Contrato?
  despachos    Despacho[]
  liquidacion  Liquidacion?

  @@map("solicitudes_financiamiento")
}

model PaqueteItem {
  id          String                  @id @default(uuid())
  solicitudId String
  solicitud   SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  categoria       CategoriaInsumo
  nombreInsumo    String
  unidad          String
  cantidad        Decimal @db.Decimal(12, 2)
  costoUnitario   Decimal @db.Decimal(12, 2)
  etapaAplicacion String?

  createdAt DateTime @default(now())

  @@map("paquete_items")
}

// ==========================================================================
// INVENTARIO DE INSUMOS — CAD compra a stock (con precio real e histórico),
// y los productores retiran de a poco según lo van necesitando, no todo el
// paquete de una vez. `PaqueteItem` arriba sigue siendo el plan/presupuesto
// aprobado; esto de aquí es lo que realmente entró y salió del almacén.
// ==========================================================================

model Insumo {
  id        String          @id @default(uuid())
  nombre    String
  categoria CategoriaInsumo
  unidad    String // kg, l, saco, unidad...

  // Se recalculan solos con cada compra/retiro — nunca se editan a mano.
  stockActual            Decimal @default(0) @db.Decimal(14, 2)
  costoPromedioPonderado Decimal @default(0) @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compras    CompraInsumo[]
  retiros    RetiroInsumo[]
  ventaItems VentaItem[]

  @@map("insumos")
}

// Cada compra sube el stock y deja un registro histórico del precio pagado
// ese día — así se puede ver cómo ha subido/bajado el costo en el tiempo.
model CompraInsumo {
  id       String @id @default(uuid())
  insumoId String
  insumo   Insumo @relation(fields: [insumoId], references: [id])

  fecha         DateTime
  cantidad      Decimal  @db.Decimal(14, 2)
  costoUnitario Decimal  @db.Decimal(14, 4)
  proveedor     String?
  notas         String?

  registradoPorId String?
  registradoPor   Usuario? @relation("CompraRegistradaPor", fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())

  @@map("compras_insumo")
}

// Un retiro real de un productor contra su expediente aprobado — baja el
// stock, congela el costo promedio ponderado del momento (no cambia si el
// precio de compra sube después), y le aplica el margen de ESA solicitud
// específica (no un porcentaje fijo del sistema).
model RetiroInsumo {
  id          String                  @id @default(uuid())
  insumoId    String
  insumo      Insumo                  @relation(fields: [insumoId], references: [id])
  solicitudId String
  solicitud   SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id])

  fecha    DateTime
  cantidad Decimal  @db.Decimal(14, 2)

  costoUnitarioAlMomento Decimal @db.Decimal(14, 4) // costo promedio ponderado congelado
  costoTotal             Decimal @db.Decimal(14, 2) // cantidad × costoUnitarioAlMomento
  montoCobradoConMargen  Decimal @db.Decimal(14, 2) // lo que realmente se le carga al productor

  registradoPorId String?
  registradoPor   Usuario? @relation("RetiroRegistradoPor", fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())

  @@map("retiros_insumo")
}

// ==========================================================================
// VENTAS — la entrega de insumos como una factura real, con varias líneas
// a la vez (ej. semilla + fertilizante en la misma entrega), en vez de un
// retiro suelto por insumo. Reemplaza a RetiroInsumo hacia adelante como el
// mecanismo principal — RetiroInsumo se deja tal cual por continuidad de lo
// ya cargado, no se borra ni se migra.
// ==========================================================================

model Venta {
  id            String                  @id @default(uuid())
  numeroFactura String                  @unique
  solicitudId   String
  solicitud     SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id])

  fecha DateTime

  subtotalCosto  Decimal @db.Decimal(14, 2) // suma del costo real (promedio ponderado) de todas las líneas
  totalConMargen Decimal @db.Decimal(14, 2) // lo que realmente se le carga al productor — sube su cuenta por cobrar

  registradoPorId String?
  registradoPor   Usuario? @relation("VentaRegistradaPor", fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())

  items VentaItem[]

  @@map("ventas")
}

model VentaItem {
  id       String @id @default(uuid())
  ventaId  String
  venta    Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  insumoId String
  insumo   Insumo @relation(fields: [insumoId], references: [id])

  cantidad               Decimal @db.Decimal(14, 2)
  costoUnitarioAlMomento Decimal @db.Decimal(14, 4) // costo promedio ponderado, congelado al momento de la venta
  costoTotal             Decimal @db.Decimal(14, 2)
  montoCobradoConMargen  Decimal @db.Decimal(14, 2)

  @@map("venta_items")
}

model Contrato {
  id          String                  @id @default(uuid())
  solicitudId String                  @unique
  solicitud   SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  tipo                     TipoContrato
  numeroContrato           String       @unique
  fechaFirma               DateTime
  archivoUrl               String?
  compromisoEntregaCosecha Boolean      @default(true)
  condicionesPago          String?

  createdAt DateTime @default(now())

  @@map("contratos")
}

model Despacho {
  id          String                  @id @default(uuid())
  solicitudId String
  solicitud   SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  tipo                 TipoDespacho
  fecha                DateTime
  etapaCultivo         String?
  montoEfectivo        Decimal?     @db.Decimal(14, 2)
  itemsDespachadosJson Json?
  valorDespachado      Decimal      @db.Decimal(14, 2)

  responsableId String?
  responsable   Usuario? @relation("DespachoResponsable", fields: [responsableId], references: [id])

  createdAt DateTime @default(now())

  @@map("despachos")
}

model Liquidacion {
  id          String                  @id @default(uuid())
  solicitudId String                  @unique
  solicitud   SolicitudFinanciamiento @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  fecha DateTime

  costoInsumosBase      Decimal @db.Decimal(14, 2)
  montoInsumosConMargen Decimal @db.Decimal(14, 2)

  montoAnticipoBase       Decimal @default(0) @db.Decimal(14, 2)
  montoAnticipoConRecargo Decimal @default(0) @db.Decimal(14, 2)

  totalACobrar Decimal @db.Decimal(14, 2)
  gananciaCAD  Decimal @db.Decimal(14, 2)

  produccionRealQq     Decimal? @db.Decimal(14, 2)
  precioLiquidacionQq  Decimal? @db.Decimal(12, 2)
  valorCosechaRecibida Decimal? @db.Decimal(14, 2)
  saldoPendiente       Decimal? @db.Decimal(14, 2)
  estadoCobranza       String   @default("PENDIENTE") // PENDIENTE / COBRADO / PARCIAL / A_FAVOR_PRODUCTOR

  notas     String?
  createdAt DateTime @default(now())

  @@map("liquidaciones")
}

// ============================================================================
// ESTADO DE CUENTA DEL PRODUCTOR
// Libro de movimientos: qué le cargamos y qué nos entregó/pagamos.
// Saldo positivo = el productor debe a CAD. Negativo = CAD debe al productor.
// ============================================================================

enum TipoMovimiento {
  CARGO_INSUMOS    // insumos despachados, con margen
  CARGO_ANTICIPO   // anticipo girado, con recargo
  CARGO_OTRO
  ABONO_COSECHA    // valor de la cosecha entregada
  ABONO_PAGO       // pago en efectivo del productor
  PAGO_A_PRODUCTOR // CAD le paga el excedente al productor
}

model MovimientoCuenta {
  id               String          @id @default(uuid())
  productorId      String
  productor        Productor       @relation(fields: [productorId], references: [id])
  cicloProductorId String?
  cicloProductor   CicloProductor? @relation(fields: [cicloProductorId], references: [id])

  tipo     TipoMovimiento
  concepto String
  fecha    DateTime
  // Monto SIEMPRE positivo. El signo lo determina el tipo (cargo vs abono),
  // así el libro es auditable y no depende de negativos sueltos.
  monto      Decimal @db.Decimal(14, 2)
  referencia String?

  registradoPorId String?
  registradoPor   Usuario? @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())

  @@map("movimientos_cuenta")
}

// ----------------------------------------------------------------------------
// NOTICIAS / CLIMA (feed externo cacheado)
// ----------------------------------------------------------------------------

enum TipoNoticia {
  CLIMA
  PRECIOS_MERCADO
  POLITICA_AGRICOLA
  OTRO
}

model NoticiaFeed {
  id               String      @id @default(uuid())
  tipo             TipoNoticia
  titulo           String
  resumen          String
  fuente           String
  url              String?     @unique
  region           String?
  rubro            String?     // "Frijol Mung", "Caraota Negra", "Maíz", "Mercado General"...
  relevancia       Int         @default(1)
  fechaPublicacion DateTime
  createdAt        DateTime    @default(now())

  @@map("noticias_feed")
}
